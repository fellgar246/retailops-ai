# --- Secrets & environment ---
.env
.env.*
!.env.example
*.pem
*.key
credentials
credentials.json
.aws/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# --- Node / Next.js ---
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
.npm/
.pnpm-store/

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
backend.hcl
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Data (keep directory structure only) ---
data/raw/*
data/processed/*
data/synthetic/*
data/forecasts/*
data/documents/*
data/reviews/*
!data/**/.gitkeep

# --- Model artifacts (keep directory structure only) ---
artifacts/models/*
!artifacts/**/.gitkeep

# --- Notebooks ---
.ipynb_checkpoints/

# Lock files belong to root configurations, not to modules.
infra/modules/*/.terraform.lock.hcl

# --- Docs ---
# Architecture decisions and architecture notes are part of the delivered
# system. Runbooks and planning material carry live infrastructure identifiers
# and internal assessments, and stay out of the repository.
reserved-docs/

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/
