# RetailOps AI — example environment configuration.
# Copy to `.env` and adjust. Never commit the real `.env`.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=retailops
POSTGRES_PASSWORD=retailops
POSTGRES_DB=retailops
POSTGRES_HOST=localhost
# Host port for the container; 5435 avoids clashing with a local PostgreSQL install.
POSTGRES_PORT=5435

# --- Backend (FastAPI) ---
APP_NAME=RetailOps AI API
ENVIRONMENT=local
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
DATABASE_URL=postgresql+psycopg://retailops:retailops@localhost:5435/retailops
CORS_ORIGINS=http://localhost:3000
# Optional. Empty uses <repo>/data/documents.
DOCUMENT_STORAGE_ROOT=

# --- Portable AI/OCR (same values locally and on AWS) ---
# Use openai / paddleocr to replace Bedrock / Textract.
# mock / local keep development offline; auto supports legacy AWS flags.
AI_REVIEW_PROVIDER=mock
DOCUMENT_OCR_PROVIDER=local
OPENAI_API_KEY=
# Set a model in your OpenAI project that supports Responses Structured Outputs.
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_TIMEOUT_SECONDS=60
PADDLEOCR_DEVICE=cpu
PADDLEOCR_MAX_PAGES=10

# --- AWS adapters (disabled locally) ---
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
AWS_ENVIRONMENT_NAME=local
AWS_RESOURCE_PREFIX=retailops
AWS_DOCUMENTS_BUCKET=
AWS_DOCUMENTS_PREFIX=supplier-documents
AWS_BEDROCK_MODEL_ID=
BEDROCK_MODEL_ID=
BEDROCK_INFERENCE_PROFILE_ID=
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0
BEDROCK_TIMEOUT_SECONDS=30
AWS_SAGEMAKER_MODEL_GROUP=category-forecast
AWS_SAGEMAKER_ARTIFACT_PREFIX=models
AWS_USE_S3_STORAGE=false
AWS_USE_TEXTRACT=false
AWS_USE_BEDROCK=false
BEDROCK_ENABLED=false
AWS_USE_SAGEMAKER_REGISTRY=false

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
