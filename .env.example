# RetailOps AI — example environment configuration.
# Copy to `.env` and adjust. Never commit the real `.env`.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=retailops
POSTGRES_PASSWORD=retailops
POSTGRES_DB=retailops
POSTGRES_HOST=localhost
# Host port for the container; 5435 avoids clashing with a local PostgreSQL install.
POSTGRES_PORT=5435

# --- Backend (FastAPI) ---
APP_NAME=RetailOps AI API
ENVIRONMENT=local
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
DATABASE_URL=postgresql+psycopg://retailops:retailops@localhost:5435/retailops
CORS_ORIGINS=http://localhost:3000
# Optional. Empty uses <repo>/data/documents.
DOCUMENT_STORAGE_ROOT=

# --- Portable AI/OCR (same values locally and on AWS) ---
# Use openai / paddleocr to replace Bedrock / Textract.
# mock / local keep development offline; auto supports legacy AWS flags.
AI_REVIEW_PROVIDER=mock
DOCUMENT_OCR_PROVIDER=local
OPENAI_API_KEY=
# Set a model in your OpenAI project that supports Responses Structured Outputs.
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_TIMEOUT_SECONDS=60
PADDLEOCR_DEVICE=cpu
PADDLEOCR_MAX_PAGES=10

# --- AWS adapters (disabled locally) ---
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
AWS_ENVIRONMENT_NAME=local
AWS_RESOURCE_PREFIX=retailops
AWS_DOCUMENTS_BUCKET=
AWS_DOCUMENTS_PREFIX=supplier-documents
AWS_BEDROCK_MODEL_ID=
BEDROCK_MODEL_ID=
BEDROCK_INFERENCE_PROFILE_ID=
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0
BEDROCK_TIMEOUT_SECONDS=30
AWS_SAGEMAKER_MODEL_GROUP=category-forecast
AWS_SAGEMAKER_ARTIFACT_PREFIX=models
AWS_USE_S3_STORAGE=false
AWS_USE_TEXTRACT=false
AWS_USE_BEDROCK=false
BEDROCK_ENABLED=false
AWS_USE_SAGEMAKER_REGISTRY=false

# --- Frontend (Next.js) ---
# --- Identity -------------------------------------------------------------
# The local provider signs its own development tokens: no cloud, no cost.
# Both applications must share the same secret. Replace it outside development.
AUTH_PROVIDER=local
AUTH_LOCAL_SECRET=retailops-local-development-identity-secret

# Hosted provider. Set AUTH_PROVIDER=cognito and fill these in from the
# Terraform outputs of the environment you are pointing at.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=
COGNITO_DOMAIN=

# --- Asynchronous work -----------------------------------------------------
# The database queue needs no broker and no cloud. Set JOB_QUEUE_PROVIDER=sqs
# and JOBS_QUEUE_URL to hand work to a hosted queue instead.
JOB_QUEUE_PROVIDER=database
JOBS_QUEUE_URL=

# How many application instances run. More than one cannot share a local
# filesystem, so document storage must be an object store above 1.
INSTANCE_COUNT=1

# --- Web ------------------------------------------------------------------
# The browser talks only to the web application, which forwards to the API and
# attaches the credential server-side.
API_ORIGIN=http://localhost:8000
APP_ORIGIN=http://localhost:3000
